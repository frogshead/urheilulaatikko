# Copy to .env and fill in. `.env` is git-ignored.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/totp
KEYCLOAK_ISSUER=http://localhost:8080/realms/lock-demo
TOTP_SERVER_KEYCLOAK_CLIENT_ID=totp-server
TOTP_SERVER_KEYCLOAK_CLIENT_SECRET=dev-secret-change-me

# AES-256 key for encrypting TOTP secrets at rest: 32 bytes, base64.
# Generate one with:  openssl rand -base64 32
# In production this belongs in a vault/KMS, not in an environment variable.
TOTP_ENCRYPTION_KEY=base64:REPLACE_ME_32_BYTES

# Steps of clock drift the *lock* is expected to tolerate. The server always
# generates the code for the current step; this value is only reported on
# /healthz so the lock's configuration can be cross-checked.
TOTP_SKEW_STEPS=1

RATE_LIMIT_MAX_REQUESTS=6
RATE_LIMIT_WINDOW_SECONDS=300

# Passwords for the users created by the imported dev realm.
TEST_USER_PASSWORD=change-me
TEST_ADMIN_PASSWORD=change-me-too

RUST_LOG=info,totp_server=debug

# Host ports published by docker-compose. Override if something else on this
# machine already owns one of the defaults.
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
TOTP_SERVER_PORT=3000
